# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง ( .env ถูก gitignore ไว้แล้ว )

# ===== ERP ต้นทาง : READ-ONLY เท่านั้น =====
# เครื่องนี้บอบบางมาก ห้าม INSERT/UPDATE/DELETE/DDL ใด ๆ
ERP_HOST=192.168.2.2
ERP_PORT=1433
ERP_DATABASE=Romar1
ERP_USER=readonly_user
ERP_PASSWORD=
ERP_DRIVER=ODBC Driver 17 for SQL Server

# ===== คลังข้อมูลรายงาน (ปลายทางที่เขียนได้) =====
# dev: sqlite  |  prod: mssql
WAREHOUSE_KIND=sqlite
WAREHOUSE_PATH=./data/purchase.sqlite

# ใช้เมื่อ WAREHOUSE_KIND=mssql (SQL Server 2022 ตอนขึ้น production)
WH_HOST=
WH_DATABASE=PurchaseRPT
WH_USER=
WH_PASSWORD=

# ===== แอป =====
# 127.0.0.1 = เปิดได้เฉพาะเครื่องนี้ | 0.0.0.0 = ให้เครื่องอื่นในวงแลนเข้าได้ด้วย
# ถ้าใช้ 0.0.0.0 ต้องเปิด firewall พอร์ตนี้ด้วย และควรตั้งรหัสผ่านก่อน
APP_HOST=127.0.0.1
APP_PORT=8080
SYNC_INTERVAL_MINUTES=15
